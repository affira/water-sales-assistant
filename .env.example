# Environment variables for the Norvale sales assistant (all data in this project is synthetic).
# Copy to .env for local use (.env is gitignored), or set these in your shell / Azure Container Apps.
# Placeholder values only: never put a real key in this file.

# Which LLM backend to use: anthropic (default) | azure_openai | foundry_claude
LLM_PROVIDER=anthropic

# --- anthropic: the Anthropic API ---------------------------------------------------
# Required for LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: model used for the agent and for report extraction.
AQUAASSIST_MODEL=claude-opus-5-5

# --- shared settings (Claude backends) ----------------------------------------------
# Optional: reasoning effort for agent turns (low | medium | high | xhigh | max).
AQUAASSIST_EFFORT=medium
# Optional: reasoning effort for the one-time report extraction.
AQUAASSIST_EXTRACTION_EFFORT=low

# --- azure_openai: an Azure OpenAI deployment in Microsoft Foundry -------------------
# Required for LLM_PROVIDER=azure_openai. Endpoint without a path, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# Optional: v1 (default, recommended OpenAI() client) or a dated version such as 2024-10-21 (AzureOpenAI() client).
AZURE_OPENAI_API_VERSION=v1

# --- foundry_claude: a Claude deployment in Microsoft Foundry ------------------------
# Required for LLM_PROVIDER=foundry_claude.
ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key
# Optional: the deployment name of the Claude model in Foundry.
FOUNDRY_CLAUDE_DEPLOYMENT=claude-opus-5-5

# --- production: secrets and monitoring (leave empty to turn off) ---------------------
# Azure Key Vault URL, e.g. https://<vault-name>.vault.azure.net/ . When set, API keys are read from
# the vault (secret names: anthropic-api-key, azure-openai-api-key, anthropic-foundry-api-key) using
# DefaultAzureCredential (managed identity on Azure, az login locally); missing ones fall back to the
# variables above.
KEY_VAULT_URL=
# Application Insights connection string. When set, request/LLM latency, token counts, tool names and
# errors are exported to Azure Monitor (never message text or personal data).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional standard OpenTelemetry sampler. Empty = keep 100% of traces (right for low traffic);
# for high traffic use e.g. microsoft.rate_limited with OTEL_TRACES_SAMPLER_ARG=5 (traces per second).
OTEL_TRACES_SAMPLER=
