# Environment variables for the Norvale sales assistant (all data in this project is synthetic).
# Copy to .env for local use (.env is gitignored), or set these in your shell / Azure Container Apps.
# Placeholder values only: never put a real key in this file.

# Required to call the Claude API (read by the Anthropic SDK).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: model used for the agent and for report extraction.
AQUAASSIST_MODEL=claude-opus-5-5

# Optional: reasoning effort for agent turns (low | medium | high | xhigh | max).
AQUAASSIST_EFFORT=medium

# Optional: reasoning effort for the one-time report extraction.
AQUAASSIST_EXTRACTION_EFFORT=low
